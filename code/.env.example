# AWS credentials come from the standard credential chain (aws login / sso / profile / env).
AWS_REGION=us-east-1
# Primary model for messages, images and the agent loop.
BOW_MODEL_ID=us.amazon.nova-pro-v1:0
# Second-opinion vision model for document images.
BOW_FALLBACK_MODEL_ID=qwen.qwen3-vl-235b-a22b
# Optional price overrides, USD per 1M tokens: {"model-id": [input, output]}
# BOW_PRICE_JSON={"us.amazon.nova-pro-v1:0": [0.80, 3.20]}
